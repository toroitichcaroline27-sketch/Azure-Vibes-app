
import React from 'react';
import {
  BookOpen,
  CheckCircle2,
  AlertTriangle,
  Compass,
  ArrowRight,
  Flame,
  Zap,
  ShieldCheck,
  Server,
  Database,
  BarChart3,
  Timer,
  CalendarDays,
  Target
} from 'lucide-react';
import { UserProgress, AZDomain } from '../types';

interface DashboardViewProps {
  progress: UserProgress | null;
  onStartQuiz: (domain: 'all' | AZDomain, filter?: string) => void;
  onOpenFlashcards: () => void;
  onAskAI: (initialPrompt?: string) => void;
  onOpenPlanner: () => void;
}

const domains: {
  id: AZDomain;
  title: string;
  description: string;
  weight: string;
  icon: React.ElementType;
  color: string;
  scoreKey: 'concepts' | 'architecture' | 'management';
}[] = [
  {
    id: 'concepts',
    title: 'Cloud Concepts',
    description:
      'Cloud models, shared responsibility, consumption-based pricing, and cloud benefits.',
    weight: '25–30%',
    icon: Database,
    color: 'sky',
    scoreKey: 'concepts'
  },
  {
    id: 'architecture',
    title: 'Azure Architecture and Services',
    description:
      'Azure regions, availability zones, compute, networking, and storage services.',
    weight: '35–40%',
    icon: Server,
    color: 'emerald',
    scoreKey: 'architecture'
  },
  {
    id: 'management',
    title: 'Azure Management and Governance',
    description:
      'Cost management, governance tools, security, compliance, and monitoring.',
    weight: '30–35%',
    icon: ShieldCheck,
    color: 'indigo',
    scoreKey: 'management'
  }
];

export const DashboardView: React.FC<DashboardViewProps> = ({
  progress,
  onStartQuiz,
  onOpenFlashcards,
  onAskAI: _onAskAI,
  onOpenPlanner
}) => {
  const readiness = progress?.overallReadiness ?? 0;
  const domainScores = progress?.domainScores ?? {
    concepts: 0,
    architecture: 0,
    management: 0
  };
  const weakAreas = progress?.weakAreas ?? [];
  const unlockedBadges = progress?.unlockedBadges ?? [];
  const streak = progress?.streakDays ?? 0;
  const xp = progress?.xp ?? 0;

  return (
    <div className="space-y-8 animate-fadeIn">
      {/* Welcome */}
      <section className="relative overflow-hidden rounded-2xl border border-sky-500/20 bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 p-6 sm:p-8 shadow-xl">
        <div className="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-sky-500/10 blur-3xl" />
        <div className="pointer-events-none absolute -bottom-20 right-1/3 h-52 w-52 rounded-full bg-cyan-500/10 blur-3xl" />

        <div className="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div className="max-w-2xl space-y-4">
            <div className="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-semibold text-sky-300">
              <BookOpen className="h-4 w-4" />
              AZ-900 Learning Dashboard
            </div>

            <h1 className="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Learn Azure, one topic at a time.
            </h1>

            <p className="max-w-xl text-sm leading-6 text-slate-300 sm:text-base">
              Choose an exam topic, practise what you've learned, and use your
              results to decide what to study next.
            </p>

            <div className="flex flex-wrap gap-3 pt-1">
              <button
                type="button"
                onClick={() => onStartQuiz('all')}
                className="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-sky-400"
              >
                <Compass className="h-4 w-4" />
                Quick Practice
                <ArrowRight className="h-4 w-4" />
              </button>

              <button
                type="button"
                onClick={() => onStartQuiz('all', 'mock-exam')}
                className="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/70 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
              >
                <Timer className="h-4 w-4 text-amber-400" />
                Mock Exam
              </button>
            </div>
          </div>

          <div className="flex min-w-44 flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-5 text-center">
            <div className="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
              Exam Readiness
            </div>

            <div className="relative flex h-32 w-32 items-center justify-center">
              <svg
                viewBox="0 0 120 120"
                className="h-full w-full -rotate-90"
                role="img"
                aria-label={`Exam readiness ${readiness} percent`}
              >
                <circle
                  cx="60"
                  cy="60"
                  r="49"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="9"
                  className="text-slate-700"
                />
                <circle
                  cx="60"
                  cy="60"
                  r="49"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="9"
                  strokeLinecap="round"
                  strokeDasharray={2 * Math.PI * 49}
                  strokeDashoffset={
                    2 * Math.PI * 49 * (1 - Math.max(0, Math.min(100, readiness)) / 100)
                  }
                  className={
                    readiness >= 80
                      ? 'text-emerald-400'
                      : readiness >= 60
                        ? 'text-sky-400'
                        : 'text-amber-400'
                  }
                />
              </svg>

              <div className="absolute">
                <div className="text-3xl font-black text-white">
                  {readiness}%
                </div>
                <div className="text-[10px] text-slate-400">READINESS</div>
              </div>
            </div>

            <p className="mt-2 text-xs text-slate-400">
              {progress
                ? 'Based on your recorded progress'
                : 'Complete practice quizzes to build your progress'}
            </p>
          </div>
        </div>
      </section>

      {/* Progress summary */}
      <section className="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div className="azure-glass-card rounded-xl border border-slate-800 p-4">
          <div className="flex items-center gap-3">
            <div className="rounded-lg bg-amber-500/10 p-2.5 text-amber-400">
              <Flame className="h-5 w-5" />
            </div>
            <div>
              <p className="text-xs text-slate-400">Study Streak</p>
              <p className="text-xl font-bold text-white">{streak} days</p>
            </div>
          </div>
        </div>

        <div className="azure-glass-card rounded-xl border border-slate-800 p-4">
          <div className="flex items-center gap-3">
            <div className="rounded-lg bg-cyan-500/10 p-2.5 text-cyan-400">
              <Zap className="h-5 w-5" />
            </div>
            <div>
              <p className="text-xs text-slate-400">Experience Points</p>
              <p className="text-xl font-bold text-white">{xp} XP</p>
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={onOpenFlashcards}
          className="azure-glass-card rounded-xl border border-slate-800 p-4 text-left transition hover:border-sky-500/40"
        >
          <div className="flex items-center gap-3">
            <div className="rounded-lg bg-emerald-500/10 p-2.5 text-emerald-400">
              <CheckCircle2 className="h-5 w-5" />
            </div>
            <div>
              <p className="text-xs text-slate-400">Flashcards Mastered</p>
              <p className="text-xl font-bold text-white">
                {progress?.flashcards?.mastered ?? 0}/
                {progress?.flashcards?.total ?? 0}
              </p>
            </div>
            <ArrowRight className="ml-auto h-4 w-4 text-slate-500" />
          </div>
        </button>
      </section>

      {/* Domain practice */}
      <section>
        <div className="mb-5 flex flex-wrap items-end justify-between gap-3">
          <div>
            <div className="mb-1 flex items-center gap-2">
              <BookOpen className="h-5 w-5 text-sky-400" />
              <h2 className="text-xl font-bold text-white">
                Explore Exam Domains
              </h2>
            </div>
            <p className="text-sm text-slate-400">
              Choose a domain to practise its questions.
            </p>
          </div>

          <span className="text-xs text-slate-500">
            3 AZ-900 exam domains
          </span>
        </div>

        <div className="grid grid-cols-1 gap-4 lg:grid-cols-3">
          {domains.map((domain, index) => {
            const Icon = domain.icon;
            const score = domainScores[domain.scoreKey];

            const styles = {
              sky: {
                icon: 'bg-sky-500/10 text-sky-400',
                border: 'hover:border-sky-500/40',
                score: 'text-sky-400',
                bar: 'bg-sky-500'
              },
              emerald: {
                icon: 'bg-emerald-500/10 text-emerald-400',
                border: 'hover:border-emerald-500/40',
                score: 'text-emerald-400',
                bar: 'bg-emerald-500'
              },
              indigo: {
                icon: 'bg-indigo-500/10 text-indigo-400',
                border: 'hover:border-indigo-500/40',
                score: 'text-indigo-400',
                bar: 'bg-indigo-500'
              }
            }[domain.color] ?? {
              icon: 'bg-sky-500/10 text-sky-400',
              border: 'hover:border-sky-500/40',
              score: 'text-sky-400',
              bar: 'bg-sky-500',
            };

            return (
              <article
                key={domain.id}
                className={`azure-glass-card flex flex-col rounded-2xl border border-slate-800 p-5 transition ${styles.border}`}
              >
                <div className="mb-4 flex items-start justify-between gap-3">
                  <div className={`rounded-xl p-3 ${styles.icon}`}>
                    <Icon className="h-6 w-6" />
                  </div>

                  <span className="rounded-full border border-slate-700 bg-slate-800/60 px-2.5 py-1 text-xs font-semibold text-slate-300">
                    {domain.weight}
                  </span>
                </div>

                <p className="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Domain {index + 1}
                </p>

                <h3 className="text-base font-bold text-white">
                  {domain.title}
                </h3>

                <p className="mt-2 flex-1 text-sm leading-6 text-slate-400">
                  {domain.description}
                </p>

                <div className="mt-5">
                  <div className="mb-2 flex items-center justify-between text-xs">
                    <span className="text-slate-400">Recorded mastery</span>
                    <span className={`font-bold ${styles.score}`}>
                      {score}%
                    </span>
                  </div>

                  <div
                    className="h-2 overflow-hidden rounded-full bg-slate-800"
                    role="progressbar"
                    aria-label={`${domain.title} mastery`}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-valuenow={score}
                  >
                    <div
                      className={`h-full rounded-full transition-all duration-700 ${styles.bar}`}
                      style={{
                        width: `${Math.max(0, Math.min(100, score))}%`
                      }}
                    />
                  </div>
                </div>

                <button
                  type="button"
                  onClick={() => onStartQuiz(domain.id)}
                  className="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-800/60 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-sky-500/40 hover:bg-slate-800"
                >
                  Practise this domain
                  <ArrowRight className="h-4 w-4" />
                </button>
              </article>
            );
          })}
        </div>
      </section>

      {/* Weak areas and next steps */}
      <section className="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <div className="azure-glass-card rounded-2xl border border-slate-800 p-5 sm:p-6">
          <div className="mb-4 flex items-start gap-3">
            <div className="rounded-xl bg-amber-500/10 p-3 text-amber-400">
              <AlertTriangle className="h-5 w-5" />
            </div>
            <div>
              <h2 className="font-bold text-white">Topics to Review</h2>
              <p className="mt-1 text-xs leading-5 text-slate-400">
                Use your results to identify what needs more practice.
              </p>
            </div>
          </div>

          {weakAreas.length > 0 ? (
            <div className="space-y-3">
              {weakAreas.slice(0, 4).map((item, index) => (
                <div
                  key={`${item.topic}-${index}`}
                  className="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-900/40 p-3"
                >
                  <div className="min-w-0">
                    <p className="truncate text-sm font-semibold text-slate-200">
                      {item.topic}
                    </p>
                    <p className="mt-1 text-xs text-slate-400">
                      Accuracy: {item.accuracy}% · {item.domain}
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => onStartQuiz(item.domain)}
                    className="shrink-0 rounded-lg bg-sky-500/10 p-2 text-sky-400 transition hover:bg-sky-500/20"
                    aria-label={`Practise ${item.topic}`}
                    title={`Practise ${item.topic}`}
                  >
                    <ArrowRight className="h-4 w-4" />
                  </button>
                </div>
              ))}

              <button
                type="button"
                onClick={() => onStartQuiz('all', 'weak-areas')}
                className="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300"
              >
                Practise weak areas
                <ArrowRight className="h-4 w-4" />
              </button>
            </div>
          ) : (
            <div className="rounded-xl border border-dashed border-slate-700 p-5 text-center">
              <Target className="mx-auto mb-2 h-6 w-6 text-slate-500" />
              <p className="text-sm font-medium text-slate-300">
                Your review list will appear here.
              </p>
              <p className="mt-1 text-xs leading-5 text-slate-500">
                Complete some practice questions to discover which topics
                deserve more attention.
              </p>
              <button
                type="button"
                onClick={() => onStartQuiz('all')}
                className="mt-4 rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-sky-400"
              >
                Start practising
              </button>
            </div>
          )}
        </div>

        <div className="azure-glass-card rounded-2xl border border-slate-800 p-5 sm:p-6">
          <div className="mb-4 flex items-start gap-3">
            <div className="rounded-xl bg-sky-500/10 p-3 text-sky-400">
              <CalendarDays className="h-5 w-5" />
            </div>
            <div>
              <h2 className="font-bold text-white">Your Next Study Session</h2>
              <p className="mt-1 text-xs leading-5 text-slate-400">
                Keep your preparation consistent with a plan that works for you.
              </p>
            </div>
          </div>

          <div className="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
            <h3 className="font-semibold text-slate-200">
              A simple session to get started
            </h3>

            <ul className="mt-3 space-y-3 text-sm text-slate-400">
              <li className="flex items-start gap-2">
                <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
                Study one AZ-900 topic.
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
                Practise questions and read the explanations.
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
                Review mistakes before moving on.
              </li>
            </ul>
          </div>

          <button
            type="button"
            onClick={onOpenPlanner}
            className="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-sky-500 px-4 py-3 text-sm font-bold text-slate-950 transition hover:bg-sky-400"
          >
            Open Study Planner
            <ArrowRight className="h-4 w-4" />
          </button>

          {unlockedBadges.length > 0 && (
            <div className="mt-5 border-t border-slate-800 pt-4">
              <h3 className="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
                Achievements
              </h3>
              <div className="flex flex-wrap gap-2">
                {unlockedBadges.slice(0, 4).map((badge) => (
                  <span
                    key={badge.id}
                    title={badge.description}
                    className="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-900/60 px-2.5 py-1.5 text-xs text-slate-300"
                  >
                    <span>{badge.icon}</span>
                    {badge.name}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Existing flashcard feature remains accessible */}
      <section className="flex flex-col gap-4 rounded-2xl border border-sky-500/20 bg-sky-500/5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div className="flex items-start gap-3">
          <div className="rounded-xl bg-sky-500/10 p-3 text-sky-400">
            <BarChart3 className="h-5 w-5" />
          </div>
          <div>
            <h2 className="font-bold text-white">Build lasting knowledge</h2>
            <p className="mt-1 text-sm leading-6 text-slate-400">
              Use flashcards to revisit important Azure terms and reinforce
              what you've learned.
            </p>
          </div>
        </div>

        <button
          type="button"
          onClick={onOpenFlashcards}
          className="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-sky-500/30 bg-sky-500/10 px-4 py-3 text-sm font-semibold text-sky-300 transition hover:bg-sky-500/20"
        >
          Review Flashcards
          <ArrowRight className="h-4 w-4" />
        </button>
      </section>
    </div>
  );
};
