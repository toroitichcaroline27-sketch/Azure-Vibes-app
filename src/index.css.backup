@import "tailwindcss";

@layer base {
  body {
    background-color: #070d18;
    color: #f1f5f9;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }
}

/* Glassmorphism and Card Glows */
.azure-glass {
  background: rgba(15, 23, 42, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(56, 189, 248, 0.12);
}

.azure-glass-card {
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.8) 100%);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(148, 163, 184, 0.12);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.azure-glass-card:hover {
  border-color: rgba(56, 189, 248, 0.35);
  box-shadow: 0 10px 30px -10px rgba(14, 165, 233, 0.2);
}

.azure-glow-blue {
  box-shadow: 0 0 25px -5px rgba(14, 165, 233, 0.35);
}

.azure-glow-emerald {
  box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.35);
}

.azure-glow-amber {
  box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.35);
}

/* 3D Flashcard Flip utilities */
.perspective-1000 {
  perspective: 1000px;
}

.transform-style-3d {
  transform-style: preserve-3d;
}

.backface-hidden {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.rotate-y-180 {
  transform: rotateY(180deg);
}

/* Custom scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #0f172a;
}

::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #0284c7;
}
